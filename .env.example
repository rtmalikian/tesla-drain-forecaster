# Tesla Fleet API application credentials (developer.tesla.com)
TESLA_CLIENT_ID=
TESLA_CLIENT_SECRET=<redacted>
TESLA_REGION=na
TESLA_REDIRECT_URI=http://localhost:8080/callback

# Your vehicles: name=VIN pairs, comma-separated
TDF_VEHICLES=Model Y=YOUR_VIN_HERE,Model 3=SECOND_VIN_HERE

# The OpenAI-compatible server THIS app exposes
TDF_SERVER_HOST=127.0.0.1
TDF_SERVER_PORT=8650
# Optional: require Authorization: Bearer <key> on /v1/* (recommended if exposed on LAN)
TDF_SERVER_API_KEY=<redacted>
TDF_MODEL_ID=tesla-drain-forecaster

# Pluggable LLM backend — any OpenAI-compatible API. Default: local Ollama.
# The app works FULLY without a backend (rules engine); the LLM only explains
# the drain stats in free-form words. Vehicle data is sent only to
# this backend — nowhere else. This app never wakes or commands a car.
TDF_AI_BASE_URL=http://localhost:11434/v1
TDF_AI_API_KEY=<redacted>
TDF_AI_MODEL=llama3.1
# auto = rules first, LLM for the rest | always = LLM first | never = rules only
TDF_AI_MODE=auto
TDF_AI_TIMEOUT_SECONDS=20

TDF_EMBEDDING_DIM=384
TDF_TOKEN_FILE=~/.tdf/tokens.json
# 1 = preview actions instead of storing them
TDF_DRY_RUN=0

# Drain-forecast rules — plain words, set by `tdrain setup`
# Flag a forecast at or above this % overnight loss (most parked Teslas
# lose 1–2%; 4% is a good flag line)
TDF_ALERT_THRESHOLD_PCT=4
# How many of the most recent drain nights the model learns from
TDF_BASELINE_NIGHTS=14
# An overnight low below this °F counts as a "cold night"
TDF_COLD_THRESHOLD_F=40
TDF_DATA_FILE=~/.tdf/drain.jsonl
